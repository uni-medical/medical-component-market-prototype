    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.3",
    "jsdom": "^27.2.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3",
